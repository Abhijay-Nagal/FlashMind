# Optional: send section requests to another server implementing POST /api/generate
# (e.g. the FastAPI backend next to the institute GPU). Defaults to the same-origin Vercel function.
VITE_GENERATE_URL=

# Used by the Vercel function and by `npm run dev` (put real values in .env.local)
GROQ_API_KEY=
